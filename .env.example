# Cyberdeck — 模型 API Key 配置
# 复制此文件为 .env，填上你要用的 provider 的 key
# 路径: ~/.hermes/profiles/cyberdeck/.env

# DeepSeek (默认)
DEEPSEEK_API_KEY=sk-xxx

# OpenAI / 第三方兼容 API
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini
GEMINI_API_KEY=xxx

# Ollama (本地，无需 API key)
# 确保先启动: ollama serve
# OLLAMA_BASE_URL=http://localhost:11434/v1
